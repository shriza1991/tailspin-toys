---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Set(games.map((game) => game.category?.name).filter((name): name is string => Boolean(name)))].sort();
const publishers = [...new Set(games.map((game) => game.publisher?.name).filter((name): name is string => Boolean(name)))].sort();
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="flex flex-col gap-4 mb-6">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
              <p class="text-sm text-slate-400" data-testid="games-filter-status" aria-live="polite">
                Showing {games.length} {games.length === 1 ? 'game' : 'games'}
              </p>
            </div>

            <form class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto] gap-4 p-4 bg-slate-800/60 rounded-xl border border-slate-700" data-testid="games-filter-form">
              <div>
                <label for="category-filter" class="block text-sm font-medium text-slate-300 mb-2">Category</label>
                <select
                  id="category-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="category-filter"
                >
                  <option value="">All categories</option>
                  {categories.map((category) => <option value={category}>{category}</option>)}
                </select>
              </div>

              <div>
                <label for="publisher-filter" class="block text-sm font-medium text-slate-300 mb-2">Publisher</label>
                <select
                  id="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher}>{publisher}</option>)}
                </select>
              </div>

              <button
                type="reset"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </form>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="mt-6" data-testid="filtered-empty-state" hidden>
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="games-filter-form"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const status = document.querySelector<HTMLElement>('[data-testid="games-filter-status"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  const updateVisibleGames = (): void => {
    const category = categoryFilter?.value ?? '';
    const publisher = publisherFilter?.value ?? '';
    let visibleCount = 0;

    for (const card of cards) {
      const matchesCategory = !category || card.dataset.gameCategory === category;
      const matchesPublisher = !publisher || card.dataset.gamePublisher === publisher;
      const isVisible = matchesCategory && matchesPublisher;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount++;
      }
    }

    if (status) {
      status.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    }
    if (emptyState) {
      emptyState.hidden = visibleCount !== 0;
    }
  };

  categoryFilter?.addEventListener('change', updateVisibleGames);
  publisherFilter?.addEventListener('change', updateVisibleGames);
  filterForm?.addEventListener('reset', () => {
    requestAnimationFrame(updateVisibleGames);
  });
</script>
